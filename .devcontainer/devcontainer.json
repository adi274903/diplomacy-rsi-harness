{
  "name": "diplomacy-rsi",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "postCreateCommand": "pip install --user uv && make setup && make test && make smoke && make viewer RUN=mock1-smoke",
  "forwardPorts": [
    8765,
    9000,
    9001
  ],
  "portsAttributes": {
    "8765": {
      "label": "RSI viewer"
    },
    "9000": {
      "label": "player gateway"
    },
    "9001": {
      "label": "reviewer gateway"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
