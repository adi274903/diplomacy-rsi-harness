# Copy to .env and fill in. Never commit .env.
# Player model API (Inkling 2 Mini provider)
PLAYER_API_BASE=https://YOUR_PROVIDER/v1
PLAYER_API_KEY=
# Reviewer model API (stronger model, different family)
REVIEWER_API_BASE=https://YOUR_REVIEWER_PROVIDER/v1
REVIEWER_API_KEY=
# Spend caps enforced by rsi-gateway (USD) and prices per million tokens for cost tracking
PLAYER_USD_BUDGET=50
REVIEWER_USD_BUDGET=50
PLAYER_USD_PER_MTOK_IN=0
PLAYER_USD_PER_MTOK_OUT=0
REVIEWER_USD_PER_MTOK_IN=0
REVIEWER_USD_PER_MTOK_OUT=0
